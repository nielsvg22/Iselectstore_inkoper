# --- Verplicht ---
DATABASE_URL="postgresql://dealhunter:dealhunter@localhost:5432/dealhunter"
# Minimaal 32 tekens. Genereer met: openssl rand -hex 32
# Wordt gebruikt voor sessies en voor het versleutelen van API-sleutels in de database.
# LET OP: wijzigt u deze, dan zijn opgeslagen geheimen (Telegram/AI) niet meer te ontsleutelen.
APP_SECRET=""

# --- Achtergrondjobs ---
# Geheim waarmee een externe scheduler (Vercel Cron, cron-job.org, systemd timer) /api/jobs/tick mag aanroepen (min. 16 tekens)
CRON_SECRET=""
# Interval van de standalone worker (npm run worker), in seconden
WORKER_INTERVAL_SECONDS=20

# --- Eerste beheerder (alleen voor `npm run db:seed`; alternatief: open /setup in de browser) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
# SEED_DEMO=1  # laad gemarkeerde voorbeeldadvertenties bij het seeden

# --- Optionele fallbacks voor geheimen (de instellingenpagina heeft voorrang) ---
# AI_API_KEY=""
# TELEGRAM_BOT_TOKEN=""
# DISCORD_WEBHOOK_URL=""

# Alleen voor lokaal testen over http (cookies zonder Secure-vlag):
# INSECURE_COOKIES=1

# --- Web Push (VAPID) ---
# Optioneel: zonder deze waarden genereert de app eenmalig een sleutelpaar en bewaart de private sleutel
# versleuteld in de database (alleen server-side). Zet VAPID_SUBJECT op een echt contactadres (mailto:… of https://…).
# VAPID_SUBJECT="mailto:inkoop@jouwdomein.nl"
# VAPID_PUBLIC_KEY=""   # genereer met: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=""

# --- Worker ---
# Wachttijd (sec) als er niets te doen is; bij werk draait de worker direct door.
# WORKER_INTERVAL_SECONDS=5
# Optional: own, approved Marktplaats OAuth access token. NOT a GoedGeplaatst API key.
# The official source stays disabled until enabled AND accessApproved in settings.
# Tokens expire; 401/403 pauses the source until the token is replaced.
MARKTPLAATS_ACCESS_TOKEN=
